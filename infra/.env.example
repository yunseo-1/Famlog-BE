# 로컬 개발용 예시. 복사해서 infra/.env 로 만들고 값을 바꾼다: cp infra/.env.example infra/.env
# infra/.env 는 커밋하지 않는다 (.gitignore).

# PostgreSQL
POSTGRES_DB=famlog
POSTGRES_USER=famlog
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# S3 호환 저장소 (로컬: SeaweedFS)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_MEDIA=famlog-media
S3_PORT=8333
S3_FILER_PORT=8888

# 소셜 로그인 (비밀 아님, 환경마다 다름). 비어 있으면 해당 제공자 로그인만 실패한다
# KAKAO_APP_ID: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 ID (숫자)
# GOOGLE_CLIENT_ID: Google Cloud > 사용자 인증 정보 > "웹 애플리케이션" OAuth 클라이언트 ID
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# JWT 서명 키 (ES256). 직접 쓰지 말고 infra/scripts/gen-jwt-key.sh 로 만든다
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

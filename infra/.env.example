# 로컬 개발용 예시. 복사해서 infra/.env 로 만들고 값을 바꾼다: cp infra/.env.example infra/.env
# infra/.env 는 커밋하지 않는다 (.gitignore).

# PostgreSQL
POSTGRES_DB=famlog
POSTGRES_USER=famlog
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# S3 호환 저장소 (로컬: SeaweedFS)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_MEDIA=famlog-media
S3_PORT=8333
S3_FILER_PORT=8888
# 앱에 주는 업로드·내려받기 주소. Android 에뮬레이터에서 시험할 때: http://10.0.2.2:8333 (비우면 http://localhost:8333)
S3_PUBLIC_ENDPOINT=

# 소셜 로그인 (비밀 아님, 환경마다 다름). 비어 있으면 해당 제공자 로그인만 실패한다
# KAKAO_APP_ID: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 ID (숫자)
# GOOGLE_CLIENT_ID: Google Cloud > 사용자 인증 정보 > "웹 애플리케이션" OAuth 클라이언트 ID
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# 장소 검색 (카카오 로컬). 비밀이다: 커밋하지 않는다. 비어 있으면 장소 검색만 실패한다
# KAKAO_REST_API_KEY: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (Admin 키가 아니다)
KAKAO_REST_API_KEY=

# 푸시 FCM 서비스 계정 키 파일 경로 (저장소 밖에 둔다, 예: ~/.famlog/firebase-adminsdk.json).
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키. 비어 있으면 서버가 푸시를 보내지 않고 로그만 남긴다
FIREBASE_CREDENTIALS_PATH=

# AI 대화 분석 (워커). LLM_PROVIDER=fake 면 LLM 을 부르지 않는다. anthropic 이면 ANTHROPIC_API_KEY 필요
# ANTHROPIC_API_KEY: Claude Console > API Keys. 비밀이다: 커밋하지 않는다. Console 에서 사용 한도도 걸어 둔다
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# JWT 서명 키 (ES256). 직접 쓰지 말고 infra/scripts/gen-jwt-key.sh 로 만든다
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 관리자 도구 토큰 (S20-2). openssl rand -hex 32 로 만든다. 비어 있으면 /admin API 가 꺼진다(404)
FAMLOG_ADMIN_TOKEN=

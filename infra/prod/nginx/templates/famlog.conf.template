# FamLog 운영 Nginx (사양서 9.4: TLS 1.2 이상·HSTS, 9.6: 관리 경로 비공개). 시작할 때 ${FAMLOG_DOMAIN} 만 바꿔 넣는다.
# 인증서: Let's Encrypt (/etc/letsencrypt/live/famlog, infra/prod/scripts/init-cert.sh·renew-cert.sh)
# 앱 API 는 api.<도메인>, 계정 삭제 안내·초대 링크는 <도메인> 으로 받는다 (둘 다 같은 API 서버로 보낸다)

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream famlog_api {
    server api:8080;
    keepalive 16;
}

# HTTP: 인증서 발급 확인만 받고 나머지는 HTTPS 로 보낸다
server {
    listen 80;
    listen [::]:80;
    server_name ${FAMLOG_DOMAIN} api.${FAMLOG_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FAMLOG_DOMAIN} api.${FAMLOG_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/famlog/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/famlog/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    # 업로드 파일은 S3 Presigned URL 로 직접 가므로 API 본문은 작다
    client_max_body_size 2m;

    # 관리자 도구·관리 경로는 밖에서 막는다. 관리자 도구는 SSM 터널로 127.0.0.1:8080 에 붙어 쓴다 (docs/runbooks/deploy.md)
    location ^~ /admin   { return 404; }
    location ^~ /actuator { return 404; }

    # 채팅 STOMP (WebSocket). 연결이 오래 유지된다
    location /ws {
        proxy_pass http://famlog_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://famlog_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 60s;
    }
}

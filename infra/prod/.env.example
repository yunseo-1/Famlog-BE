# 운영 서버 비밀·설정 형식 (S22-1). 서버에서 infra/prod/scripts/init-env.sh 가 이 파일로 /opt/famlog/.env 를 만들고
# 무작위 값(DB·Redis 비밀번호, JWT 키, 관리자 토큰, 백업 암호)을 채운다. 로컬 infra/.env 값은 쓰지 않는다.
# 빈 칸(외부 서비스 값)은 서버에서 직접 채운다: sudo nano /opt/famlog/.env (값을 출력·복사·커밋하지 않는다)

# 도메인 (api.<도메인> 이 앱 API 주소). 인증서 만료 안내를 받을 이메일
FAMLOG_DOMAIN=famlog.kr
ACME_EMAIL=

# 이미지 저장소 (GitHub Actions 가 올린다). 태그는 deploy.sh 가 배포한 커밋 SHA 로 바꿔 둔다 (직접 고치지 않는다)
FAMLOG_IMAGE_REPO=ghcr.io/yunseo-1
FAMLOG_IMAGE_TAG=

# PostgreSQL·Redis (같은 VM 의 컨테이너, 외부 비공개)
POSTGRES_DB=famlog
POSTGRES_USER=famlog
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# S3: 접근 키 없이 EC2 인스턴스 역할로 접근한다
S3_BUCKET_MEDIA=
S3_REGION=ap-northeast-2

# 소셜 로그인·장소 검색 (카카오 디벨로퍼스, Google Cloud). KAKAO_REST_API_KEY 는 비밀
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=
KAKAO_REST_API_KEY=

# AI 대화 분석 (워커). 운영용 키를 따로 만들고 Console 에서 사용 한도를 건다
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# JWT 서명 키 (init-env.sh 가 만든다)
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 관리자 도구 토큰 (init-env.sh 가 만든다)
FAMLOG_ADMIN_TOKEN=

# DB 백업 (docs/runbooks/backup.md). 암호는 init-env.sh 가 만들고, 비밀번호 관리자에도 보관한다 (잃으면 복구 불가)
# BACKUP_S3_URI: 서버 밖 사본 (백업 전용 버킷, 30일 뒤 자동 삭제). 비우면 서버에만 둔다
BACKUP_PASSPHRASE=
BACKUP_DIR=/opt/famlog/backups
BACKUP_RETENTION_DAYS=7
BACKUP_S3_URI=
# 성공 시각 기록 (node-exporter 가 읽어 26시간 넘게 성공이 없으면 Discord 알림)
BACKUP_METRICS_DIR=/opt/famlog/metrics
